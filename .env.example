# Your Hermoso API key: app.hermoso.ai > "API, MCP & CLI" tab > Terminal & API keys.
# It stays on the server; it is never sent to the browser.
HERMOSO_API_KEY=

# Optional: the brand (profile) to open on, an id from GET /v1/brands.
# Omit to open on the brand the key is pinned to.
HERMOSO_BRAND=

# Optional but recommended for any deployed copy: anyone who can open the app can post
# with your key, so set a password and the app asks for it (HTTP basic auth, any username).
APP_PASSWORD=
